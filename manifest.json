{
  "manifest_version": 3,
  "name": "Bookmark Grid",
  "version": "1.0.0",
  "description": "A minimal new-tab grid for Firefox's Other Bookmarks.",
  "permissions": ["bookmarks", "storage", "tabs"],
  "icons": {
    "16": "extension-icon.svg",
    "32": "extension-icon.svg",
    "48": "extension-icon.svg",
    "96": "extension-icon.svg"
  },
  "action": {
    "default_title": "Bookmark Grid",
    "default_icon": "toolbar-icon.svg",
    "default_popup": "popup.html",
    "theme_icons": [
      { "light": "toolbar-icon.svg", "dark": "toolbar-icon.svg", "size": 16 },
      { "light": "toolbar-icon.svg", "dark": "toolbar-icon.svg", "size": 32 }
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bmgrid@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
